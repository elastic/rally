class Actor:
    def __init__(self) -> None: ...
    def receiveMessage(self, msg: Any, sender: ActorAddress) -> Any: ...
    @property
    def myAddress(self) -> ActorAddress: ...
    @property
    def globalName(self) -> str: ...
    def createActor(
        self,
        actorClass: type[Actor] | str,
        targetActorRequirements: Mapping[str, Any] | None = None,
        globalName: str | None = None,
        sourceHash: str | None = None,
    ) -> ActorAddress: ...
    # NOTE: `targetAddr` must be an `ActorAddress` at runtime (anything else raises InvalidActorAddress). It is
    # typed as `Any` for now because the not yet annotated actor modules (driver, mechanic, racecontrol) keep
    # addresses in attributes initialised to `None`. Tighten to `ActorAddress` once those modules are typed.
    def send(self, targetAddr: Any, msg: Any) -> None: ...
    def wakeupAfter(self, timePeriod: datetime.timedelta | float, payload: Any = None) -> None: ...
    def handleDeadLetters(self, startHandling: bool = True) -> None: ...
    def registerSourceAuthority(self) -> None: ...
    def notifyOnSystemRegistrationChanges(self, startHandling: bool = True) -> None: ...
    # NOTE: thespian defines `def logger(self, name=None)` here, returning a LoggerAdapter. It is
    # deliberately left out of this stub because `esrally.actor.RallyActor` shadows it with a
    # `logging.Logger` instance attribute that every Rally actor uses as `self.logger.info(...)`.
    # Declaring the method would turn all of those uses into type errors. Add it back once Rally
    # stops shadowing the method.
    def updateCapability(self, capabilityName: str, capabilityValue: Any = None) -> None: ...
    def loadActorSource(self, fname: str) -> str: ...
    def unloadActorSource(self, sourceHash: str) -> None: ...
    def notifyOnSourceAvailability(self, enable: bool = True) -> None: ...
    def preRegisterRemoteSystem(self, remoteAddress: str, remoteCapabilities: Mapping[str, Any]) -> None: ...
    def deRegisterRemoteSystem(self, remoteAddress: str | ActorAddress) -> None: ...
    def actorSystemShutdown(self) -> None: ...

